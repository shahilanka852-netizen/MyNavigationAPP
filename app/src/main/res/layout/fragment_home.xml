<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F3F6FC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MY NAVIGATION APP"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#243B64" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2025621036 bahadur shahi lanka Welcome to my navigation project!"
        android:textSize="17sp"
        android:textColor="#46546A"
        android:gravity="center"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnMoveMenu"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Open Menu"
        android:layout_marginTop="30dp" />

</LinearLayout>
